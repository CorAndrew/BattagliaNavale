<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BattagliaNavale.MainWindow"
        Title="Battaglia Navale"
        Width="900" Height="650">
    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
            <Button Name="BtnInserimentoNavi" Content="Inserimento Navi" Click="BtnInserimentoNavi_Click"/>
            <Button Name="BtnGioco" Content="Gioco" Click="BtnGioco_Click"/>
        </StackPanel>

        <ContentControl Name="ContenutoPrincipale"/>
    </DockPanel>
</Window>